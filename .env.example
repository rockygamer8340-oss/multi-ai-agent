# ---------- LLM ----------
# LLM_PROVIDER: openai | anthropic | gemini | groq | ollama
# Sabse aasaan free + tez: gemini (key: https://aistudio.google.com/apikey)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
# Har minute max LLM calls. -1 = auto (gemini free tier: 4), 0 = no limit
LLM_RPM=-1

OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
GOOGLE_API_KEY=
GROQ_API_KEY=
# Ollama (local model). Docker ke andar se host ka Ollama: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# Ollama context window (tokens). 16GB RAM par 16384 theek hai; RAM kam ho toh 8192
OLLAMA_NUM_CTX=16384

# ---------- Search ----------
# SEARCH_PROVIDER: tavily (best) | serpapi (Google) | duckduckgo (bina key, testing ke liye)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your-tavily-key-here
SERPAPI_API_KEY=
SEARCH_RESULTS_PER_TASK=4
PAGE_CHARS=5000

# ---------- Agent behaviour ----------
MAX_SUBTASKS=5
MAX_REVISIONS=2
MIN_SOURCES_FOR_VERIFIED=2
MAX_CONCURRENCY=5
# Fast mode: kam LLM calls (Fact-checker/Critic code se). Free Gemini ke liye true rakho
FAST_MODE=false

# ---------- Monitoring (Langfuse) - optional ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- API ----------
# Next.js jaisa alag frontend ho toh uska URL (comma-separated)
CORS_ORIGINS=*

# ---------- Frontend ----------
# Streamlit backend ko yahan call karega
API_URL=http://localhost:8000
